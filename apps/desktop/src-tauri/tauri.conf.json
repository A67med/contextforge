{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContextForge",
  "mainBinaryName": "contextforge-desktop",
  "version": "0.1.0",
  "identifier": "dev.contextforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ContextForge",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0d0e10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ContextForge contributors",
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "One memory. Every coding agent.",
    "longDescription": "Local-first, provenance-aware shared project memory for Claude Code, OpenAI Codex and Google Antigravity.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/contextforge"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
